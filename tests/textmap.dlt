import eqoi

# The mapping between the text as stored and the text as drawn.
#
# Positions are checked against the mapping's own offsets rather than against
# hardcoded pixel counts, because what is being tested is the ORDER: which
# glyph a character became, and which edge of it the caret belongs on.

fun main() -> i32:
    app: EqoiApp = EqoiApp.headless(600, 400)
    if app.is_valid() == 0:
        print("eqoi textmap: headless app creation failed")
        return 1
    buf: i64 = app.alloc_buf(128)

    # ---------------------------------------------------------------
    # Latin: drawn in the order it is stored, so the caret walks forward.
    # ---------------------------------------------------------------
    app.text_insert(buf, 127, 0, "abc")
    if app.text_map_build(buf, 127) == 0:
        print("eqoi textmap: could not map latin text")
        app.destroy()
        return 2
    if app.text_map_display_count() != 3:
        print("eqoi textmap: latin changed length")
        app.destroy()
        return 3
    if app.text_map_caret_x(0) != 0:
        print("eqoi textmap: the latin caret does not start at the left")
        app.destroy()
        return 4
    if app.text_map_caret_x(3) != app.text_map_width():
        print("eqoi textmap: the latin caret does not end at the right")
        app.destroy()
        return 5
    if app.text_map_caret_x(1) != app.text_map_advance(0):
        print("eqoi textmap: the latin caret did not advance one glyph")
        app.destroy()
        return 6
    if app.text_map_index_at(1) != 0:
        print("eqoi textmap: a click at the far left is not before the text")
        app.destroy()
        return 7
    if app.text_map_index_at(app.text_map_width() - 1) != 3:
        print("eqoi textmap: a click at the far right is not after the text")
        app.destroy()
        return 8

    # ---------------------------------------------------------------
    # Arabic: the first stored letter is drawn LAST, so the caret before
    # it belongs at the right-hand end.
    # ---------------------------------------------------------------
    app.text_delete_range(buf, 3, 0, 3)
    app.text_caret = 0
    app.text_anchor = 0
    app.text_insert(buf, 127, 0, "مرحبا")
    if app.text_map_build(buf, 127) == 0:
        print("eqoi textmap: could not map Arabic text")
        app.destroy()
        return 9
    if app.text_map_display_count() != 5:
        print("eqoi textmap: the Arabic word changed length")
        app.destroy()
        return 10

    # The glyph drawn first came from the LAST stored letter.
    if app.text_map_source(0) != 4:
        print("eqoi textmap: the leftmost glyph is not the last letter")
        app.destroy()
        return 11
    if app.text_map_source(4) != 0:
        print("eqoi textmap: the rightmost glyph is not the first letter")
        app.destroy()
        return 12
    if app.text_map_is_rtl_glyph(0) != 1:
        print("eqoi textmap: an Arabic glyph is not marked right to left")
        app.destroy()
        return 13

    # A caret before the first letter sits at the right-hand end.
    if app.text_map_caret_x(0) != app.text_map_width():
        print("eqoi textmap: the caret before the first Arabic letter is not on the right")
        app.destroy()
        return 14
    # A caret after the last letter sits at the left-hand end.
    if app.text_map_caret_x(5) != 0:
        print("eqoi textmap: the caret after the last Arabic letter is not on the left")
        app.destroy()
        return 15
    # And it walks leftwards, one glyph at a time.
    if app.text_map_caret_x(1) != app.text_map_offset(4):
        print("eqoi textmap: the Arabic caret did not step leftwards")
        app.destroy()
        return 16

    # Clicking mirrors: the far right is the start of the text.
    if app.text_map_index_at(app.text_map_width() - 1) != 0:
        print("eqoi textmap: a click at the right of Arabic is not the start")
        app.destroy()
        return 17
    if app.text_map_index_at(1) != 5:
        print("eqoi textmap: a click at the left of Arabic is not the end")
        app.destroy()
        return 18

    # ---------------------------------------------------------------
    # Mixed. Stored: م ر ح ب ا _ a b c
    # Drawn:  a b c _ ا ب ح ر م
    # The latin run keeps its own direction inside the Arabic line, so the
    # caret before 'a' belongs on its LEFT while the caret before the first
    # Arabic letter belongs on the far right.
    # ---------------------------------------------------------------
    app.text_delete_range(buf, app.text_length(buf, 127), 0, app.text_length(buf, 127))
    app.text_caret = 0
    app.text_anchor = 0
    app.text_insert(buf, 127, 0, "مرحبا abc")
    if app.text_map_build(buf, 127) == 0:
        print("eqoi textmap: could not map mixed text")
        app.destroy()
        return 19
    if app.text_map_display_count() != 9:
        print("eqoi textmap: the mixed line changed length")
        app.destroy()
        return 20
    if app.text_map_source(0) != 6 or app.text_map_source(2) != 8:
        print("eqoi textmap: the latin run is not drawn first")
        app.destroy()
        return 21
    if app.text_map_source(8) != 0:
        print("eqoi textmap: the first Arabic letter is not drawn last")
        app.destroy()
        return 22
    if app.text_map_is_rtl_glyph(0) != 0:
        print("eqoi textmap: the latin run is marked right to left")
        app.destroy()
        return 23
    if app.text_map_caret_x(6) != 0:
        print("eqoi textmap: the caret before the latin run is not at its left")
        app.destroy()
        return 24
    if app.text_map_caret_x(0) != app.text_map_width():
        print("eqoi textmap: the caret before the Arabic is not at the far right")
        app.destroy()
        return 25

    # ---------------------------------------------------------------
    # A lam-alef ligature is one glyph made of two stored letters. A caret
    # between them has no glyph of its own and must land on the far side of
    # the ligature rather than falling to the end of the line.
    # ---------------------------------------------------------------
    app.text_delete_range(buf, app.text_length(buf, 127), 0, app.text_length(buf, 127))
    app.text_caret = 0
    app.text_anchor = 0
    app.text_insert(buf, 127, 0, "بلا")
    if app.text_map_build(buf, 127) == 0:
        print("eqoi textmap: could not map the ligature")
        app.destroy()
        return 26
    if app.text_map_display_count() != 2:
        print("eqoi textmap: the ligature did not shorten the line")
        app.destroy()
        return 27
    # Stored is ب(0) ل(1) ا(2); drawn is [ligature(from 1), beh(0)].
    if app.text_map_source(0) != 1 or app.text_map_source(1) != 0:
        print("eqoi textmap: the ligature reports the wrong source")
        app.destroy()
        return 28
    # A caret between the lam and the alef sits at the ligature's far side,
    # not at the end of the line.
    if app.text_map_caret_x(2) != app.text_map_offset(0):
        print("eqoi textmap: a caret inside a ligature fell off the line")
        app.destroy()
        return 29

    # ---------------------------------------------------------------
    # Byte and codepoint positions are not the same once the text is not
    # ASCII, and the caret is stored in bytes.
    # ---------------------------------------------------------------
    if app.text_bytes_to_codepoints(buf, 0) != 0:
        print("eqoi textmap: a zero byte offset is not a zero index")
        app.destroy()
        return 30
    if app.text_bytes_to_codepoints(buf, 4) != 2:
        print("eqoi textmap: four bytes of Arabic are not two characters")
        app.destroy()
        return 31
    if app.text_codepoints_to_bytes(buf, 127, 2) != 4:
        print("eqoi textmap: two characters of Arabic are not four bytes")
        app.destroy()
        return 32

    app.destroy()
    print("eqoi textmap: ok")
    return 0
