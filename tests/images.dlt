import eqoi
import image

# Drawing pixel buffers.
#
# The first thing checked is the channel order. The image package stores red
# first and the surface stores blue first, so a conversion that is skipped or
# written backwards produces a picture that looks fine in shape and wrong in
# colour — the kind of bug that ships because nothing crashes.

fun put_rgba(buffer: i64, index: i32, r: i32, g: i32, b: i32, a: i32):
    Memory.write_i32(buffer + (index as i64) * 4, (r & 255) | ((g & 255) << 8) | ((b & 255) << 16) | ((a & 255) << 24))

fun main() -> i32:
    app: EqoiApp = EqoiApp.headless(200, 200)
    if app.is_valid() == 0:
        print("eqoi images: headless app creation failed")
        return 1

    # A 2x2 source: red, green / blue, transparent.
    source: i64 = Memory.malloc_zeroed(16)
    if source == 0:
        print("eqoi images: allocation failed")
        app.destroy()
        return 2
    put_rgba(source, 0, 255, 0, 0, 255)
    put_rgba(source, 1, 0, 255, 0, 255)
    put_rgba(source, 2, 0, 0, 255, 255)
    put_rgba(source, 3, 255, 255, 255, 0)

    picture: EqoiImage = app.new_image_rgba(source, 2, 2, 8)
    if picture.is_valid() != 1:
        print("eqoi images: the handle was not built")
        app.destroy()
        return 3

    # ---------------------------------------------------------------
    # Red stays red. If the conversion were skipped, this pixel would
    # come out blue and everything else would still pass.
    # ---------------------------------------------------------------
    app.inject_mouse_move(190, 190)
    if app.begin_offscreen() == 1:
        app.image(10, 10, picture)
        app.end()
    if app.pixel_at(10, 10) != ui_rgb(255, 0, 0):
        print("eqoi images: red did not survive the channel conversion")
        app.destroy()
        return 4
    if app.pixel_at(11, 10) != ui_rgb(0, 255, 0):
        print("eqoi images: green is wrong")
        app.destroy()
        return 5
    if app.pixel_at(10, 11) != ui_rgb(0, 0, 255):
        print("eqoi images: blue is wrong")
        app.destroy()
        return 6

    # A fully transparent pixel leaves what was underneath alone.
    if app.pixel_at(11, 11) != app.theme.background:
        print("eqoi images: a transparent pixel overwrote the background")
        app.destroy()
        return 7

    # And nothing was drawn outside the two-by-two.
    if app.pixel_at(12, 10) == ui_rgb(255, 0, 0):
        print("eqoi images: the image drew past its width")
        app.destroy()
        return 8

    # ---------------------------------------------------------------
    # Scaling repeats each source pixel, sampling nearest.
    # ---------------------------------------------------------------
    if app.begin_offscreen() == 1:
        app.image_scaled(20, 20, 40, 40, picture, 0)
        app.end()
    if app.pixel_at(20, 20) != ui_rgb(255, 0, 0) or app.pixel_at(39, 39) != ui_rgb(255, 0, 0):
        print("eqoi images: the top-left quarter is not the first pixel")
        app.destroy()
        return 9
    if app.pixel_at(40, 20) != ui_rgb(0, 255, 0):
        print("eqoi images: the top-right quarter is not the second pixel")
        app.destroy()
        return 10
    if app.pixel_at(20, 40) != ui_rgb(0, 0, 255):
        print("eqoi images: the bottom-left quarter is not the third pixel")
        app.destroy()
        return 11

    # ---------------------------------------------------------------
    # A tint multiplies. White through a red tint is red; the green
    # pixel through a red tint goes black, because it has no red in it.
    # ---------------------------------------------------------------
    if app.begin_offscreen() == 1:
        app.icon(60, 60, 20, 20, picture, ui_rgb(255, 0, 0))
        app.end()
    if app.pixel_at(60, 60) != ui_rgb(255, 0, 0):
        print("eqoi images: a red pixel through a red tint changed")
        app.destroy()
        return 12
    if app.pixel_at(75, 60) != ui_rgb(0, 0, 0):
        print("eqoi images: a green pixel through a red tint kept its green")
        app.destroy()
        return 13

    # ---------------------------------------------------------------
    # Fitting preserves the shape rather than stretching it. A square
    # into a wide box stays square and is centred.
    # ---------------------------------------------------------------
    if app.begin_offscreen() == 1:
        app.image_fit(100, 100, 80, 40, picture)
        app.end()
    # 40 tall, so 40 wide, centred in 80: it starts at 100 + 20.
    if app.pixel_at(120, 100) != ui_rgb(255, 0, 0):
        print("eqoi images: the fitted image is not where it should be")
        app.destroy()
        return 14
    if app.pixel_at(105, 100) == ui_rgb(255, 0, 0):
        print("eqoi images: the fitted image was stretched to the box")
        app.destroy()
        return 15

    # ---------------------------------------------------------------
    # An image obeys the clip stack like everything else.
    # ---------------------------------------------------------------
    if app.begin_offscreen() == 1:
        app.push_clip(0, 0, 12, 200)
        app.image_scaled(0, 150, 40, 40, picture, 0)
        app.pop_clip()
        app.end()
    if app.pixel_at(5, 155) != ui_rgb(255, 0, 0):
        print("eqoi images: the clipped image did not draw inside the clip")
        app.destroy()
        return 16
    if app.pixel_at(20, 155) == ui_rgb(255, 0, 0):
        print("eqoi images: the image drew outside the clip")
        app.destroy()
        return 17

    # An empty handle draws nothing rather than reaching through a null.
    empty: EqoiImage = EqoiImage()
    if app.begin_offscreen() == 1:
        app.image(150, 150, empty)
        app.end()
    if app.pixel_at(150, 150) != app.theme.background:
        print("eqoi images: an empty handle drew something")
        app.destroy()
        return 18
    Memory.free(source)

    # ---------------------------------------------------------------
    # End to end through the image package: build a picture, write it as
    # a PNG, read it back, and draw what came out.
    # ---------------------------------------------------------------
    made: Image = Image.create(4, 4)
    if made.data == 0:
        app.destroy()
        print("eqoi images: ok (drawing only; the image package would not allocate)")
        return 0
    i: i32 = 0
    while i < 16:
        Memory.write_i32(made.data + (i as i64) * 4, image_rgba(200, 30, 40, 255))
        i = i + 1

    path: str = "eqoi_image_roundtrip.png"
    if PNG.save(made, path) == 0:
        app.destroy()
        print("eqoi images: ok (drawing only; PNG could not be written here)")
        return 0
    loaded: Image = PNG.load(path)
    if loaded.data == 0 or loaded.width != 4 or loaded.height != 4:
        app.destroy()
        print("eqoi images: the PNG did not read back")
        return 19

    from_png: EqoiImage = app.new_image_rgba(loaded.data, loaded.width, loaded.height, loaded.stride)
    if app.begin_offscreen() == 1:
        app.image(160, 10, from_png)
        app.end()
    if app.pixel_at(160, 10) != ui_rgb(200, 30, 40):
        print("eqoi images: a decoded PNG did not draw in its own colours")
        app.destroy()
        return 20

    app.destroy()
    print("eqoi images: ok")
    return 0
