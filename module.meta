# Eqoi Module Metadata
# High-level native app framework for Dolet.
# Owns the window + event pump; widgets on top of ui.

[info]
name = eqoi
version = 0.7.0
description = Native application framework for Dolet with loadable proportional TrueType text, anti-aliased widgets, lifecycle, software surfaces, input snapshots, responsive layout, themes, managed state, and application services on top of ui.

[dependencies]
window = required
ui = required
input = required
fonts = required

[link.windows]
# Native linking is inherited from window/input.

[link.linux]
# Native linking is inherited from window/input.

[link.macos]
# Planned later.
