# Eqoi Module Metadata
# High-level native app framework for Dolet.
# Owns the window + event pump; widgets on top of ui.

[info]
name = eqoi
version = 0.14.0
layer = composition
no-bindings = true
description = Native application framework for Dolet with frame timing and animated widget states, a virtualized data table, caret and selection text editing, keyboard focus traversal, a nestable widget identity stack, headless offscreen testing, loadable proportional TrueType text, anti-aliased widgets, lifecycle, software surfaces, input snapshots, flexible responsive layout with alignment, wrapping and grids, themes, managed state, and application services on top of ui.

[dependencies]
window = required
ui = required
input = required
fonts = required

[link.windows]
# Native linking is inherited from window/input.

[link.linux]
# Native linking is inherited from window/input.

[link.macos]
# Planned later.
