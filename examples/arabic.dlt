import eqoi
import text

# Arabic, one stage at a time.
#
# Three lines per sample show what each stage of the pipeline contributes:
#
#   raw       the codepoints as stored, drawn straight through
#   shaped    each letter given the form its neighbours call for
#   display   shaped, then reordered right to left by UAX #9
#
# Only the third line is correct Arabic. The first two are here because the
# difference between them is the whole point.
#
# The font is loaded from the system rather than shipped: Eqoi's built-in face
# covers ASCII only, and no Arabic face is redistributed with this repository.

FONT_PATH: str = "C:/Windows/Fonts/arial.ttf"

fun prepare_shaped(app: EqoiApp, source: str) -> i64:
    buffer: i64 = app.alloc_buf(256)
    if buffer == 0:
        return 0
    arabic_shape_str(source, buffer, 255)
    return buffer

fun prepare_display(app: EqoiApp, source: str) -> i64:
    buffer: i64 = app.alloc_buf(256)
    if buffer == 0:
        return 0
    text_display_str(source, buffer, 255)
    return buffer

fun sample(app: EqoiApp, y: i32, title: str, raw: str, shaped: i64, display: i64) -> i32:
    app.title(30, y, title)
    app.muted_label(30, y + 30, "raw")
    app.text(150, y + 30, raw, app.theme.muted_text)
    app.muted_label(30, y + 56, "shaped")
    app.text(150, y + 56, shaped as str, app.theme.text)
    app.muted_label(30, y + 82, "display")
    app.text(150, y + 82, display as str, app.theme.accent)
    return y + 122

fun main() -> i32:
    app: EqoiApp = EqoiApp.create("Eqoi Arabic", 900, 620)
    if app.is_valid() == 0:
        return 1

    face: FontFace = font_face_load_ttf(FONT_PATH, 22)
    loaded: i32 = face.is_valid()
    if loaded == 1:
        app.use_font(face)

    hello: str = "مرحبا"
    greeting: str = "السلام عليكم"
    phrase: str = "لا اله الا الله"
    mixed: str = "مرحبا abc 123"

    hello_s: i64 = prepare_shaped(app, hello)
    hello_d: i64 = prepare_display(app, hello)
    greeting_s: i64 = prepare_shaped(app, greeting)
    greeting_d: i64 = prepare_display(app, greeting)
    phrase_s: i64 = prepare_shaped(app, phrase)
    phrase_d: i64 = prepare_display(app, phrase)
    mixed_s: i64 = prepare_shaped(app, mixed)
    mixed_d: i64 = prepare_display(app, mixed)

    while app.running() == 1:
        if app.begin() == 1:
            app.title(30, 24, "Arabic through the text package")
            if loaded == 0:
                app.text(30, 60, "Could not load the system font; only ASCII will draw.", app.theme.danger)
            else:
                app.muted_label(30, 58, "face: arial.ttf 22px, loaded from the system through app.use_font")

            y: i32 = 96
            y = sample(app, y, "one word", hello, hello_s, hello_d)
            y = sample(app, y, "a greeting", greeting, greeting_s, greeting_d)
            y = sample(app, y, "a phrase with lam-alef", phrase, phrase_s, phrase_d)
            y = sample(app, y, "mixed with latin and numbers", mixed, mixed_s, mixed_d)

            app.separator(30, y + 4, 840)
            app.muted_label(30, y + 18, "In the mixed line the digits stay 123, not 321, and sit left of the Arabic.")
            app.end()

    app.destroy()
    if loaded == 1:
        face.destroy()
    return 0
