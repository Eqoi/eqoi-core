# ============================
#  Eqoi Text Editing
# ============================
# A caret and a selection for single-line text input.
#
# Only one input can hold keyboard focus, so one set of caret state serves
# every input in the application; text_owner records whose it currently is.
# That keeps the caller's contract unchanged — an input is still just a byte
# buffer and a maximum length — while giving the widget a real editing model
# instead of append-and-backspace.
#
# The selection is the span between anchor and caret, in either order. An
# empty selection means anchor and caret sit together.
#
# Positions are byte offsets. That is correct for the ASCII the input layer
# currently delivers; when the text package lands and multi-byte input starts
# arriving, these become grapheme offsets and every caller keeps working
# because none of them index the buffer themselves.

attach EqoiApp:
    # Length of the NUL-terminated buffer, bounded by max_len.
    fun text_length(self, buf: i64, max_len: i32) -> i32:
        n: i32 = 0
        b: i8 = 0 as i8
        while n < max_len:
            b = Memory.read_i8(buf + (n as i64))
            if b == 0:
                return n
            n = n + 1
        return n

    # Width of the first `count` bytes. Measured through the active face by
    # borrowing the buffer's own terminator, so no allocation is needed.
    fun text_prefix_width(self, buf: i64, count: i32) -> i32:
        if count <= 0:
            return 0
        at: i64 = buf + (count as i64)
        saved: i8 = Memory.read_i8(at)
        Memory.write_i8(at, 0 as i8)
        width: i32 = self.text_width(buf as str)
        Memory.write_i8(at, saved)
        return width

    # Byte offset nearest to a pixel position, snapping to whichever side of
    # the glyph the pointer is closer to.
    fun text_index_at(self, buf: i64, length: i32, text_x: i32, target_x: i32) -> i32:
        if target_x <= text_x:
            return 0
        best: i32 = 0
        i: i32 = 0
        while i <= length:
            if text_x + self.text_prefix_width(buf, i) <= target_x:
                best = i
            i = i + 1
        if best < length:
            near: i32 = target_x - (text_x + self.text_prefix_width(buf, best))
            far: i32 = (text_x + self.text_prefix_width(buf, best + 1)) - target_x
            if near > far:
                best = best + 1
        return best

    # ---------------------------------------------------------------
    # Selection
    # ---------------------------------------------------------------
    fun text_has_selection(self) -> i32:
        if self.text_caret == self.text_anchor:
            return 0
        return 1

    fun text_sel_start(self) -> i32:
        if self.text_caret < self.text_anchor:
            return self.text_caret
        return self.text_anchor

    fun text_sel_end(self) -> i32:
        if self.text_caret > self.text_anchor:
            return self.text_caret
        return self.text_anchor

    fun text_select_all(self, length: i32):
        self.text_anchor = 0
        self.text_caret = length

    # Take the caret when focus arrives, and keep it inside the buffer when
    # the application edits it behind the widget's back.
    fun text_claim(self, id: i64, length: i32):
        if self.text_owner == id:
            if self.text_caret > length:
                self.text_caret = length
            if self.text_anchor > length:
                self.text_anchor = length
            return
        self.text_owner = id
        self.text_caret = length
        self.text_anchor = length
        self.text_dragging = 0

    fun text_move_caret(self, position: i32, extend: i32, length: i32):
        p: i32 = position
        if p < 0:
            p = 0
        if p > length:
            p = length
        self.text_caret = p
        if extend == 0:
            self.text_anchor = p

    # ---------------------------------------------------------------
    # Mutation
    # ---------------------------------------------------------------
    # Remove [from_index, to_index) and pull the tail down. Returns the new
    # length. Copied byte by byte because the ranges overlap.
    fun text_delete_range(self, buf: i64, length: i32, from_index: i32, to_index: i32) -> i32:
        a: i32 = from_index
        b: i32 = to_index
        if a < 0:
            a = 0
        if b > length:
            b = length
        if b <= a:
            return length
        i: i32 = a
        j: i32 = b
        while j < length:
            Memory.write_i8(buf + (i as i64), Memory.read_i8(buf + (j as i64)))
            i = i + 1
            j = j + 1
        Memory.write_i8(buf + (i as i64), 0 as i8)
        return i

    fun text_delete_selection(self, buf: i64, length: i32) -> i32:
        if self.text_has_selection() == 0:
            return length
        start: i32 = self.text_sel_start()
        result: i32 = self.text_delete_range(buf, length, start, self.text_sel_end())
        self.text_caret = start
        self.text_anchor = start
        return result

    # Insert at the caret, replacing any selection. Truncates at max_len
    # rather than overrunning. Returns the new length.
    fun text_insert(self, buf: i64, max_len: i32, length: i32, value: str) -> i32:
        len_now: i32 = self.text_delete_selection(buf, length)
        add: i32 = Memory.strlen(value) as i32
        room: i32 = max_len - len_now
        if add > room:
            add = room
        if add <= 0:
            return len_now

        # Shift the tail right, back to front, so unread bytes survive.
        i: i32 = len_now
        while i > self.text_caret:
            Memory.write_i8(buf + ((i + add - 1) as i64), Memory.read_i8(buf + ((i - 1) as i64)))
            i = i - 1
        k: i32 = 0
        while k < add:
            Memory.write_i8(buf + ((self.text_caret + k) as i64), Memory.read_i8((value as i64) + (k as i64)))
            k = k + 1

        len_now = len_now + add
        Memory.write_i8(buf + (len_now as i64), 0 as i8)
        self.text_caret = self.text_caret + add
        self.text_anchor = self.text_caret
        return len_now

    # ---------------------------------------------------------------
    # One frame of keyboard editing. Returns 1 if the buffer changed.
    # ---------------------------------------------------------------
    fun text_apply_keys(self, buf: i64, max_len: i32) -> i32:
        length: i32 = self.text_length(buf, max_len)
        changed: i32 = 0
        extend: i32 = self.input_state.shift_down

        # Ctrl+A selects everything. Ctrl+C/X/V wait on a clipboard in the
        # window package; nothing here pretends they work.
        if self.input_state.ctrl_down == 1:
            if Memory.strlen(self.input_state.typed_chars) > 0:
                first: i8 = Memory.read_i8(self.input_state.typed_chars as i64)
                if first == 1 as i8:
                    self.text_select_all(length)
                return 0

        if self.input_state.left_pressed == 1:
            self.text_move_caret(self.text_caret - 1, extend, length)
        if self.input_state.right_pressed == 1:
            self.text_move_caret(self.text_caret + 1, extend, length)
        if self.input_state.home_pressed == 1:
            self.text_move_caret(0, extend, length)
        if self.input_state.end_pressed == 1:
            self.text_move_caret(length, extend, length)

        if self.input_state.backspace == 1:
            if self.text_has_selection() == 1:
                length = self.text_delete_selection(buf, length)
                changed = 1
            elif self.text_caret > 0:
                length = self.text_delete_range(buf, length, self.text_caret - 1, self.text_caret)
                self.text_caret = self.text_caret - 1
                self.text_anchor = self.text_caret
                changed = 1

        if self.input_state.delete_pressed == 1:
            if self.text_has_selection() == 1:
                length = self.text_delete_selection(buf, length)
                changed = 1
            elif self.text_caret < length:
                length = self.text_delete_range(buf, length, self.text_caret, self.text_caret + 1)
                changed = 1

        if Memory.strlen(self.input_state.typed_chars) > 0:
            before: i32 = length
            length = self.text_insert(buf, max_len, length, self.input_state.typed_chars)
            if length != before:
                changed = 1

        return changed
