# ============================
#  Eqoi Theme
# ============================

struct EqoiTheme:
    background: UIColor = 0
    surface: UIColor = 0
    surface_hover: UIColor = 0
    surface_active: UIColor = 0
    text: UIColor = 0
    muted_text: UIColor = 0
    accent: UIColor = 0
    accent_hover: UIColor = 0
    border: UIColor = 0
    danger: UIColor = 0
    spacing: i32 = 12
    padding: i32 = 14
    border_width: i32 = 1
    corner_radius: i32 = 6
    # The focus ring. Thin by default: it marks where the keyboard is, and a
    # marker that has to shout is covering for being in the wrong place.
    # A colour of 0 means unset, and falls back to accent_hover.
    focus_ring_width: i32 = 1
    focus_ring_offset: i32 = 2
    focus_ring_color: UIColor = 0

attach EqoiTheme:
    static fun dark() -> EqoiTheme:
        return EqoiTheme(
            background=ui_rgb(12, 16, 18),
            surface=ui_rgb(24, 31, 35),
            surface_hover=ui_rgb(34, 46, 52),
            surface_active=ui_rgb(43, 59, 66),
            text=ui_rgb(238, 244, 246),
            muted_text=ui_rgb(155, 169, 175),
            accent=ui_rgb(217, 119, 87),
            accent_hover=ui_rgb(229, 141, 110),
            border=ui_rgb(83, 103, 112),
            danger=ui_rgb(245, 91, 96),
            spacing=12,
            padding=14,
            border_width=1,
            corner_radius=6,
            focus_ring_width=1,
            focus_ring_offset=2,
            focus_ring_color=ui_rgb(229, 141, 110)
        )

    static fun light() -> EqoiTheme:
        return EqoiTheme(
            background=ui_rgb(242, 245, 247),
            surface=ui_rgb(255, 255, 255),
            surface_hover=ui_rgb(232, 238, 242),
            surface_active=ui_rgb(218, 227, 232),
            text=ui_rgb(24, 31, 35),
            muted_text=ui_rgb(91, 106, 113),
            accent=ui_rgb(190, 84, 54),
            accent_hover=ui_rgb(213, 104, 72),
            border=ui_rgb(177, 190, 197),
            danger=ui_rgb(204, 48, 57),
            spacing=12,
            padding=14,
            border_width=1,
            corner_radius=6,
            focus_ring_width=1,
            focus_ring_offset=2,
            focus_ring_color=ui_rgb(213, 104, 72)
        )

fun eqoi_theme_dark() -> EqoiTheme:
    return EqoiTheme.dark()

fun eqoi_theme_light() -> EqoiTheme:
    return EqoiTheme.light()
